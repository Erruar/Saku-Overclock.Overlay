<Project Sdk="Microsoft.NET.Sdk">
    
    <Import Project="$(MSBuildThisFileDirectory)..\Saku Overclock\Version.props"
            Condition="Exists('$(MSBuildThisFileDirectory)..\Saku Overclock\Version.props')" />
    
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>Saku_Overclock.Overlay</RootNamespace>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <OverlayVersion Condition="'$(OverlayVersion)' == ''">1.0.0.0</OverlayVersion>
        <AssemblyVersion>$(OverlayVersion)</AssemblyVersion>
        <FileVersion>$(OverlayVersion)</FileVersion>
        <Version>$(OverlayVersion)</Version>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Speed</OptimizationPreference>
        <InvariantGlobalization>true</InvariantGlobalization>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IlcOptimizationPreference>Size</IlcOptimizationPreference>
        <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <UseNativeHttpHandler>false</UseNativeHttpHandler>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\Saku Overclock\Assets\WindowIcon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
      <PackageReference Include="System.Drawing.Common" Version="9.0.1" />
      <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Saku Overclock.Shared\Saku Overclock.Shared\Saku Overclock.Shared.csproj" />
    </ItemGroup>

</Project>
